{
  "name": "agentjourney",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm generate && pnpm --filter @agentjourney/web build && pnpm --filter @agentjourney/host build",
    "check:local-adapters": "tsx scripts/check-local-adapters.ts",
    "dev": "concurrently -k -n host,web -c blue,magenta \"pnpm --filter @agentjourney/host dev\" \"pnpm --filter @agentjourney/web dev\"",
    "e2e": "playwright test",
    "e2e:seed": "tsx scripts/seed-e2e.ts",
    "generate": "pnpm --filter @agentjourney/contracts generate",
    "plugin:create": "tsx scripts/create-plugin.ts",
    "plugin:pack": "tsx scripts/pack-plugin.ts",
    "plugin:check": "tsx scripts/check-plugin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@agentjourney/archive": "workspace:*",
    "@agentjourney/builtin-adapters": "workspace:*",
    "@agentjourney/contracts": "workspace:*",
    "@agentjourney/plugin-runtime": "workspace:*",
    "@agentjourney/plugin-sdk": "workspace:*",
    "@agentjourney/test-fixtures": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
